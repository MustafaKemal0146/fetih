<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Fetih.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fetih.Desktop"
    xmlns:converters="using:Fetih.Desktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Marka işaretleri (vektör; bkz. assets/Branding.xaml) -->
                <ResourceDictionary Source="ms-appx:///assets/Branding.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Uygulama genelinde paylaşılan dönüştürücüler -->
            <converters:ThemeBrushConverter x:Key="ThemeBrushConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <!-- Ayar/Tanılama sayfalarında tekrarlanan stiller -->
            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>

            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="16" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>

            <!--
                Ayar sayfalarındaki "anahtar → değer" satırı.
                Tüm ayar sayfaları bu şablonu paylaşır; veri kaynağı
                Fetih.Desktop.Models.SettingRow listeleridir.
            -->
            <DataTemplate x:Key="SettingRowTemplate">
                <Grid ColumnSpacing="16" Padding="0,7,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding Label}"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                        <TextBlock Text="{Binding ConfigKey}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Opacity="0.45"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasConfigKey, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Value}"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                        <TextBlock Text="{Binding Note}"
                                   FontSize="12"
                                   Opacity="0.6"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
