<?xml version="1.0" encoding="utf-8"?>
<!--
    FETİH marka kimliği — TAMAMEN VEKTÖR.

    Neden bitmap değil: aynı işaret 16 piksellik başlık çubuğu ikonundan
    karşılama ekranındaki büyük yüzeye kadar kullanılıyor. Tek bir PNG bu
    aralığın iki ucunda da iyi görünmez; ölçeğe göre AYRI AYRI SADELEŞTİRİLMİŞ
    üç işaret gerekir:

      FetihBrandmarkTemplate   — tam sanat (devre kartı dokusu, ikon sütunu,
                                 tagline). Karşılama / Hakkında ekranları.
      FetihWordmarkTemplate    — sadece kelime işareti + ince alt çizgi.
                                 Başlık çubukları.
      FetihGlyphTemplate       — yalnızca monogram. 16–32 piksel.

    Hepsi ControlTemplate olarak tanımlı, UIElement olarak DEĞİL: bir XAML
    ögesinin tek ebeveyni olabilir, dolayısıyla StaticResource ile paylaşılan
    bir Canvas ikinci kullanımda çökerdi. Şablon her kullanımda yeniden üretilir.

    Renkler tema-bağımsız: işaret kendi koyu zeminini taşır, böylece açık
    temada da aynı görünür (marka rengi temayla değişmemeli).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Marka paleti ──────────────────────────────────────────────── -->
    <Color x:Key="FetihInkColor">#FF0A0D13</Color>
    <Color x:Key="FetihInkSoftColor">#FF141922</Color>
    <Color x:Key="FetihEmberColor">#FFFF8A2B</Color>
    <Color x:Key="FetihBloodColor">#FFD81E23</Color>

    <SolidColorBrush x:Key="FetihInkBrush" Color="{StaticResource FetihInkColor}" />
    <SolidColorBrush x:Key="FetihBloodBrush" Color="{StaticResource FetihBloodColor}" />

    <!-- Zemin: köşelerden merkeze doğru hafifçe açılan koyu alan -->
    <LinearGradientBrush x:Key="FetihPanelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource FetihInkColor}" />
        <GradientStop Offset="0.55" Color="{StaticResource FetihInkSoftColor}" />
        <GradientStop Offset="1" Color="{StaticResource FetihInkColor}" />
    </LinearGradientBrush>

    <!-- Kelime işaretinin kızıl→turuncu gradyanı (soldan sağa yükselen ısı) -->
    <LinearGradientBrush x:Key="FetihWordBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FFB3151A" />
        <GradientStop Offset="0.45" Color="{StaticResource FetihBloodColor}" />
        <GradientStop Offset="1" Color="{StaticResource FetihEmberColor}" />
    </LinearGradientBrush>

    <!-- Devre izleri: görünür ama okumayı bozmayacak kadar sönük -->
    <SolidColorBrush x:Key="FetihTraceBrush" Color="{StaticResource FetihBloodColor}" Opacity="0.34" />
    <SolidColorBrush x:Key="FetihNodeBrush" Color="{StaticResource FetihEmberColor}" Opacity="0.55" />
    <SolidColorBrush x:Key="FetihTaglineBrush" Color="#FFB9C2D0" />

    <!--
        ══ Tam sanat ══════════════════════════════════════════════════════
        640×200 tuval; Viewbox ölçekler, dolayısıyla kullanım yerinde
        yalnızca Width/Height verilir.
    -->
    <ControlTemplate x:Key="FetihBrandmarkTemplate" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="640" Height="200">
                <Border Background="{StaticResource FetihPanelBrush}" CornerRadius="16" />

                <!-- Devre kartı dokusu: ince izler + düğümler -->
                <Canvas>
                    <Path Stroke="{StaticResource FetihTraceBrush}" StrokeThickness="1.1"
                          Data="M 18,44 L 74,44 L 96,66 L 96,150 M 18,96 L 58,96 L 78,116 L 150,116
                                M 18,158 L 66,158 L 84,140
                                M 640,52 L 588,52 L 566,74 L 566,128 L 592,154 L 640,154
                                M 622,96 L 574,96 M 540,26 L 540,58 L 520,78
                                M 470,182 L 500,182 L 520,162 L 596,162" />
                    <Path Stroke="{StaticResource FetihTraceBrush}" StrokeThickness="0.8" Opacity="0.7"
                          Data="M 150,20 L 190,20 L 206,36 M 420,20 L 452,20 L 468,36
                                M 132,180 L 176,180 L 194,162 M 246,190 L 300,190" />

                    <Ellipse Canvas.Left="93" Canvas.Top="147" Width="6" Height="6" Fill="{StaticResource FetihNodeBrush}" />
                    <Ellipse Canvas.Left="147" Canvas.Top="113" Width="6" Height="6" Fill="{StaticResource FetihNodeBrush}" />
                    <Ellipse Canvas.Left="563" Canvas.Top="71" Width="6" Height="6" Fill="{StaticResource FetihNodeBrush}" />
                    <Ellipse Canvas.Left="203" Canvas.Top="33" Width="5" Height="5" Fill="{StaticResource FetihNodeBrush}" />
                    <Ellipse Canvas.Left="465" Canvas.Top="33" Width="5" Height="5" Fill="{StaticResource FetihNodeBrush}" />
                    <Ellipse Canvas.Left="297" Canvas.Top="187" Width="5" Height="5" Fill="{StaticResource FetihNodeBrush}" />
                </Canvas>

                <!--
                    Sol ikon sütunu: kafatası (saldırgan bakış açısı), kalkan
                    (savunma), kod parantezleri (terminalde çalışır). FETİH'in
                    ne yaptığını üç işaretle anlatır.
                -->
                <Canvas>
                    <!-- Kafatası -->
                    <Path Canvas.Left="26" Canvas.Top="30" Fill="{StaticResource FetihBloodBrush}" Opacity="0.92"
                          Data="M 14,0 C 22,0 28,6 28,15 L 28,22 C 28,25 26,27 24,28 L 24,33 L 18,33 L 18,29
                                L 16,29 L 16,33 L 12,33 L 12,29 L 10,29 L 10,33 L 4,33 L 4,28
                                C 2,27 0,25 0,22 L 0,15 C 0,6 6,0 14,0 Z" />
                    <Ellipse Canvas.Left="31" Canvas.Top="43" Width="7" Height="8" Fill="{StaticResource FetihInkBrush}" />
                    <Ellipse Canvas.Left="42" Canvas.Top="43" Width="7" Height="8" Fill="{StaticResource FetihInkBrush}" />

                    <!-- Kalkan -->
                    <Path Canvas.Left="26" Canvas.Top="82" Stroke="{StaticResource FetihBloodBrush}"
                          StrokeThickness="2.4" Opacity="0.92"
                          Data="M 14,1 L 27,6 L 27,19 C 27,28 21,34 14,37 C 7,34 1,28 1,19 L 1,6 Z" />
                    <Path Canvas.Left="26" Canvas.Top="82" Stroke="{StaticResource FetihEmberColor}"
                          StrokeThickness="2.2"
                          Data="M 8,18 L 12,23 L 20,13" />

                    <!-- Kod parantezleri -->
                    <Path Canvas.Left="26" Canvas.Top="138" Stroke="{StaticResource FetihBloodBrush}"
                          StrokeThickness="2.4" Opacity="0.92"
                          Data="M 10,0 L 1,11 L 10,22 M 18,0 L 27,11 L 18,22" />
                </Canvas>

                <!-- Kelime işareti + tagline -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-6,0,0">
                    <Grid>
                        <!--
                            Köşeli/faceted etki: aynı harfler bir piksel aşağı
                            kaydırılmış koyu bir kopyanın üstüne biner, sonra
                            üst yarıya ince bir açık kama düşer. Böylece harf
                            yüzeyi düz değil, kırılmış görünür — ve etki
                            ölçekten bağımsız çalışır (bitmap gölge değil).
                        -->
                        <TextBlock Text="FETİH"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="76" FontWeight="Bold"
                                   CharacterSpacing="90"
                                   Foreground="#FF3A0A0C"
                                   Margin="3,4,0,0" />
                        <TextBlock Text="FETİH"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="76" FontWeight="Bold"
                                   CharacterSpacing="90"
                                   Foreground="{StaticResource FetihWordBrush}" />
                        <!--
                            Faset kırılımı: harflerin ÜST YARISI daha sıcak bir
                            gradyanla ikinci kez çizilir ve kırpma dikdörtgeni
                            tam ortadan keser. Göz bunu düz bir yüzey değil,
                            iki düzlemli (köşeli) bir yüzey olarak okur.
                        -->
                        <TextBlock Text="FETİH"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="76" FontWeight="Bold"
                                   CharacterSpacing="90">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#FFE0332E" />
                                    <GradientStop Offset="1" Color="#FFFFA754" />
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            <TextBlock.Clip>
                                <RectangleGeometry Rect="0,0,600,47" />
                            </TextBlock.Clip>
                        </TextBlock>
                    </Grid>

                    <TextBlock Text="TERMİNALDE ÇALIŞAN OTONOM YAPAY ZEKÂ GÜVENLİK AJANI"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"
                               FontFamily="Segoe UI"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               CharacterSpacing="180"
                               Foreground="{StaticResource FetihTaglineBrush}"
                               Opacity="0.85" />
                </StackPanel>

                <!-- Sağ altta mesaj işareti: FETİH'in mesajlaşma köprüsü -->
                <Canvas>
                    <Path Canvas.Left="576" Canvas.Top="152" Stroke="{StaticResource FetihBloodBrush}"
                          StrokeThickness="2" Opacity="0.9"
                          Data="M 3,0 L 33,0 C 34.7,0 36,1.3 36,3 L 36,19 C 36,20.7 34.7,22 33,22
                                L 14,22 L 6,29 L 6,22 L 3,22 C 1.3,22 0,20.7 0,19 L 0,3 C 0,1.3 1.3,0 3,0 Z" />
                    <Ellipse Canvas.Left="585" Canvas.Top="161" Width="3.4" Height="3.4" Fill="{StaticResource FetihEmberColor}" />
                    <Ellipse Canvas.Left="592" Canvas.Top="161" Width="3.4" Height="3.4" Fill="{StaticResource FetihEmberColor}" />
                    <Ellipse Canvas.Left="599" Canvas.Top="161" Width="3.4" Height="3.4" Fill="{StaticResource FetihEmberColor}" />
                </Canvas>
            </Grid>
        </Viewbox>
    </ControlTemplate>

    <!--
        ══ Kelime işareti (başlık çubukları) ══════════════════════════════
        Devre dokusu, ikon sütunu ve tagline DÜŞER: 20 piksel yükseklikte
        hiçbiri okunmaz, yalnızca gürültü yapar. Kalan: harfler + altında
        markanın kızıl çizgisi.
    -->
    <ControlTemplate x:Key="FetihWordmarkTemplate" TargetType="ContentControl">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
            <StackPanel>
                <TextBlock Text="FETİH"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="18" FontWeight="Bold"
                           CharacterSpacing="70"
                           Foreground="{StaticResource FetihWordBrush}" />
                <Rectangle Height="2" Margin="0,1,3,0" RadiusX="1" RadiusY="1">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="{StaticResource FetihBloodColor}" />
                            <GradientStop Offset="1" Color="#00FF8A2B" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </StackPanel>
        </Viewbox>
    </ControlTemplate>

    <!--
        ══ Monogram (16–32 piksel) ════════════════════════════════════════
        Bu ölçekte "FETİH" okunmaz. Geriye kalan: köşeli bir F, kalkan
        siluetine oturmuş. Devre izi tek bir çentik olarak hayatta kalır.
    -->
    <ControlTemplate x:Key="FetihGlyphTemplate" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="64" Height="64">
                <Border Background="{StaticResource FetihPanelBrush}" CornerRadius="14" />
                <Canvas>
                    <!-- Kalkan konturu -->
                    <Path Canvas.Left="12" Canvas.Top="8" Stroke="{StaticResource FetihTraceBrush}"
                          StrokeThickness="2"
                          Data="M 20,0 L 39,7 L 39,26 C 39,40 31,49 20,54 C 9,49 1,40 1,26 L 1,7 Z" />
                    <!-- Köşeli F -->
                    <Path Canvas.Left="22" Canvas.Top="18" Fill="{StaticResource FetihWordBrush}"
                          Data="M 0,0 L 21,0 L 21,6 L 7,6 L 7,12 L 18,12 L 18,18 L 7,18 L 7,29 L 0,29 Z" />
                    <!-- Devre çentiği -->
                    <Path Stroke="{StaticResource FetihNodeBrush}" StrokeThickness="1.6"
                          Data="M 50,44 L 56,44 L 60,40" />
                </Canvas>
            </Grid>
        </Viewbox>
    </ControlTemplate>

</ResourceDictionary>
