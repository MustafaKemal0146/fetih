<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fetih.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:views="using:Fetih.Desktop.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FETİH">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Özel başlık çubuğu: marka + Masaüstü Köprüsü durum rozeti.
            Faz 3'te buraya aktif model seçici de gelecek
            (bkz. docs/windows-app-plani.md, (f) bölümü).
        -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="40"
              ColumnSpacing="12"
              Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                Başlık çubuğu marka işareti. Düz "FETİH" metni yerine
                sadeleştirilmiş kelime işareti (bkz. assets/Branding.xaml):
                bu ölçekte devre dokusu ve tagline okunmaz, o yüzden onlar
                yalnızca büyük yüzeydeki tam sanatta yer alır.
            -->
            <ContentControl Grid.Column="0"
                            Height="22"
                            VerticalAlignment="Center"
                            IsTabStop="False"
                            AutomationProperties.AutomationId="app_wordmark"
                            AutomationProperties.Name="FETİH"
                            Template="{StaticResource FetihWordmarkTemplate}" />

            <TextBlock Grid.Column="1"
                       x:Name="TaglineText"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Opacity="0.6" />

            <!--
                Durum rozeti. Nokta artık sabit sarı değil: BadgeBrushKey'den
                gelir (yeşil=bağlı, sarı=bağlanıyor, kırmızı=model/taşıma
                hatası). Hata durumunda rozet TIKLANABİLİR ve kullanıcıyı
                sorunu düzeltebileceği ayar sayfasına götürür — kırmızı bir
                nokta gösterip kullanıcıyı orada bırakmak yarım bir uyarıdır.
            -->
            <Button Grid.Column="3"
                    x:Name="StatusBadge"
                    Margin="0,0,160,0"
                    Padding="10,3"
                    VerticalAlignment="Center"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    IsTabStop="{x:Bind Status.IsActionable, Mode=OneWay}"
                    AutomationProperties.AutomationId="bridge_status_badge"
                    AutomationProperties.Name="{x:Bind Status.StateLabel, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Status.Detail, Mode=OneWay}"
                    Click="StatusBadge_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Fill="{x:Bind Status.BadgeBrush, Mode=OneWay}" />
                    <TextBlock FontSize="12"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="bridge_status_text"
                               Text="{x:Bind Status.StateLabel, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Grid>

        <!--
            MenuItems / FooterMenuItems koleksiyonları XAML'de sabit tanımlı DEĞİL:
            kod arkasındaki ObservableCollection'lardan gelir (MainWindow.xaml.cs).
            Böylece "Ayarlar"a basıldığında sol menünün tamamı Ayarlar alt
            bölümleriyle değiştirilebilir, geri tuşuyla normal moda dönülür.
        -->
        <muxc:NavigationView x:Name="RootNavigation"
                             Grid.Row="1"
                             IsSettingsVisible="True"
                             IsBackButtonVisible="Collapsed"
                             IsPaneToggleButtonVisible="True"
                             PaneDisplayMode="Left"
                             OpenPaneLength="240"
                             SelectionChanged="RootNavigation_SelectionChanged"
                             BackRequested="RootNavigation_BackRequested">
            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>
    </Grid>
</Window>
