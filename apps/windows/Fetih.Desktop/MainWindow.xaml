<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fetih.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:views="using:Fetih.Desktop.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FETİH">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewChatAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Özel başlık çubuğu: marka + Masaüstü Köprüsü durum rozeti.
            Aktif model seçici Ayarlar › Model sayfasındadır; başlık çubuğu
            yalnızca durumu gösterir.
        -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="40"
              ColumnSpacing="12"
              Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                Başlık çubuğu marka işareti. Düz "FETİH" metni yerine
                sadeleştirilmiş kelime işareti (bkz. assets/Branding.xaml):
                bu ölçekte devre dokusu ve tagline okunmaz, o yüzden onlar
                yalnızca büyük yüzeydeki tam sanatta yer alır.
            -->
            <ContentControl Grid.Column="0"
                            Height="22"
                            VerticalAlignment="Center"
                            IsTabStop="False"
                            AutomationProperties.AutomationId="app_wordmark"
                            AutomationProperties.Name="FETİH"
                            Template="{StaticResource FetihWordmarkTemplate}" />

            <TextBlock Grid.Column="1"
                       x:Name="TaglineText"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Opacity="0.6" />

            <!--
                Etkinlik paneli aç/kapat (issue #53). Orta (esnek) sütunda sağa
                yaslı; durum rozetinin solunda durur.
            -->
            <Button Grid.Column="2"
                    x:Name="ActivityToggleButton"
                    HorizontalAlignment="Right"
                    Margin="0,0,10,0"
                    Padding="8,3"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.AutomationId="activity_toggle"
                    Click="ActivityToggleButton_Click">
                <FontIcon Glyph="&#xE8A0;" FontSize="14" />
            </Button>

            <!--
                Durum rozeti. Nokta artık sabit sarı değil: BadgeBrushKey'den
                gelir (yeşil=bağlı, sarı=bağlanıyor, kırmızı=model/taşıma
                hatası). Hata durumunda rozet TIKLANABİLİR ve kullanıcıyı
                sorunu düzeltebileceği ayar sayfasına götürür — kırmızı bir
                nokta gösterip kullanıcıyı orada bırakmak yarım bir uyarıdır.
            -->
            <Button Grid.Column="3"
                    x:Name="StatusBadge"
                    Margin="0,0,160,0"
                    Padding="10,3"
                    VerticalAlignment="Center"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    IsTabStop="{x:Bind Status.IsActionable, Mode=OneWay}"
                    AutomationProperties.AutomationId="bridge_status_badge"
                    AutomationProperties.Name="{x:Bind Status.StateLabel, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Status.Detail, Mode=OneWay}"
                    Click="StatusBadge_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Fill="{x:Bind Status.BadgeBrush, Mode=OneWay}" />
                    <TextBlock FontSize="12"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="bridge_status_text"
                               Text="{x:Bind Status.StateLabel, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Grid>

        <!--
            MenuItems / FooterMenuItems koleksiyonları XAML'de sabit tanımlı DEĞİL:
            kod arkasındaki ObservableCollection'lardan gelir (MainWindow.xaml.cs).
            Böylece "Ayarlar"a basıldığında sol menünün tamamı Ayarlar alt
            bölümleriyle değiştirilebilir, geri tuşuyla normal moda dönülür.
        -->
        <!--
            İçerik alanı: sol menü + ana içerik (NavigationView) ve SAĞ TARAFTA
            açılır etkinlik paneli (issue #53). Panel sütunu varsayılan 0'dır
            (gizli); başlık çubuğundaki düğme açıp kapatır, aradaki tutamaç
            genişliğini ayarlar. Panel sohbeti daraltır ama üzerine binmez.
        -->
        <Grid x:Name="ContentArea" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ActivityPanelColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <muxc:NavigationView x:Name="RootNavigation"
                                 Grid.Column="0"
                                 IsSettingsVisible="True"
                                 IsBackButtonVisible="Collapsed"
                                 IsPaneToggleButtonVisible="True"
                                 PaneDisplayMode="Left"
                                 OpenPaneLength="240"
                                 ItemInvoked="RootNavigation_ItemInvoked"
                                 SelectionChanged="RootNavigation_SelectionChanged"
                                 BackRequested="RootNavigation_BackRequested">
                <Frame x:Name="ContentFrame" />
            </muxc:NavigationView>

            <primitives:Thumb x:Name="ActivitySizer"
                              Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              Visibility="Collapsed"
                              DragDelta="ActivitySizer_DragDelta" />

            <views:ActivityPanel x:Name="ActivityPanel" Grid.Column="2" />
        </Grid>

        <!--
            Pane genişlik tutamacı: sol menünün SAĞ kenarında ince, görünmez
            bir sürükleme şeridi. Üzerine gelince bir şey olmaz; yalnızca
            sürükleyince RootNavigation.OpenPaneLength değişir (sol sohbet
            listesini genişletip tam adları görebilmek için). Margin, pane
            genişliğiyle birlikte kod-arkasında güncellenir.
        -->
        <primitives:Thumb x:Name="PaneSizer"
                          Grid.Row="1"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Stretch"
                          Width="6"
                          Margin="234,48,0,0"
                          Background="Transparent"
                          DragDelta="PaneSizer_DragDelta" />
    </Grid>
</Window>
