<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fetih.Desktop.Views.TargetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Fetih.Desktop.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Hedef paneli (issue #34): bulgular host/URL/dosya hedefine göre
        gruplanır. Sol: hedef listesi (sayı + en yüksek ciddiyet). Sağ: seçili
        hedefin bulguları. findings.list'ten beslenir, canlı günceller.
    -->
    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="ReloadButton" VerticalAlignment="Top" Click="ReloadButton_Click" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sol: hedef listesi -->
            <Grid Grid.Column="0">
                <TextBlock x:Name="EmptyText"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.55" TextAlignment="Center" TextWrapping="Wrap" />
                <ListView x:Name="TargetList"
                          AutomationProperties.AutomationId="targets_list"
                          SelectionMode="Single"
                          SelectionChanged="TargetList_SelectionChanged"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,3" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TargetGroup">
                            <Border Padding="12,10" CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" VerticalAlignment="Center" Opacity="0.85" />
                                        <TextBlock Text="{x:Bind Target}"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Consolas"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Padding="7,1" CornerRadius="4"
                                                Background="{x:Bind SeverityBrushKey, Converter={StaticResource ThemeBrushConverter}}">
                                            <TextBlock Text="{x:Bind SeverityLabel}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{x:Bind CountLabel}" FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Sağ: seçili hedefin bulguları -->
            <Grid Grid.Column="1">
                <TextBlock x:Name="SelectHintText"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.5" TextAlignment="Center" TextWrapping="Wrap" />
                <ListView x:Name="FindingList"
                          AutomationProperties.AutomationId="targets_findings"
                          Visibility="Collapsed"
                          SelectionMode="None"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,3" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Finding">
                            <Border Padding="14,12" CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Padding="8,2" CornerRadius="4" VerticalAlignment="Center"
                                                Background="{x:Bind SeverityBrushKey, Converter={StaticResource ThemeBrushConverter}}">
                                            <TextBlock Text="{x:Bind SeverityLabel}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Target}" FontFamily="Consolas" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Evidence}" FontSize="12" TextWrapping="Wrap" MaxLines="3" Opacity="0.85" />
                                    <TextBlock Text="{x:Bind Recommendation}" FontSize="12" TextWrapping="Wrap" Opacity="0.7" />
                                    <TextBlock Text="{x:Bind Reference}" FontSize="11" Opacity="0.6"
                                               Visibility="{x:Bind HasReference, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
