<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fetih.Desktop.Views.FindingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Fetih.Desktop.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource MutedTextStyle}" />
        </StackPanel>

        <!-- Süzgeç (ciddiyet + sıralama + arama) ve aksiyonlar -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox x:Name="SeverityBox"
                          MinWidth="160"
                          AutomationProperties.AutomationId="findings_severity"
                          SelectionChanged="SeverityBox_SelectionChanged" />
                <ComboBox x:Name="SortBox"
                          MinWidth="150"
                          AutomationProperties.AutomationId="findings_sort"
                          SelectionChanged="SortBox_SelectionChanged" />
                <CheckBox x:Name="SessionOnlyBox"
                          AutomationProperties.AutomationId="findings_session_only"
                          Checked="SessionOnly_Changed"
                          Unchecked="SessionOnly_Changed" />
            </StackPanel>
            <TextBox Grid.Column="1"
                     x:Name="SearchBox"
                     MinWidth="200"
                     VerticalAlignment="Center"
                     AutomationProperties.AutomationId="findings_search"
                     TextChanged="SearchBox_TextChanged" />
            <TextBlock Grid.Column="2"
                       x:Name="CountText"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource MutedTextStyle}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <ProgressRing x:Name="ScanRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                <Button x:Name="ClearButton"
                        Click="ClearButton_Click" />
                <Button x:Name="ExportButton"
                        Click="ExportButton_Click" />
                <Button x:Name="ScanButton"
                        Click="ScanButton_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <!-- Boş durum -->
            <Border x:Name="EmptyState"
                    Style="{StaticResource CardBorderStyle}"
                    MaxWidth="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE7BA;"
                              FontSize="28"
                              HorizontalAlignment="Center"
                              Opacity="0.5" />
                    <TextBlock x:Name="EmptyTitleText"
                               FontWeight="SemiBold"
                               FontSize="16"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyDescText"
                               TextAlignment="Center"
                               Style="{StaticResource MutedTextStyle}" />
                    <TextBlock x:Name="EmptyDisclaimerText"
                               TextAlignment="Center"
                               FontSize="12"
                               Opacity="0.55"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ListView x:Name="FindingList"
                      AutomationProperties.AutomationId="findings_list"
                      Visibility="Collapsed"
                      SelectionMode="Single"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,3" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Finding">
                        <Border Padding="14,12"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Padding="8,2"
                                            CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Background="{x:Bind SeverityBrushKey, Converter={StaticResource ThemeBrushConverter}}">
                                        <TextBlock Text="{x:Bind SeverityLabel}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Title}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind TimeLabel}"
                                               FontSize="11"
                                               Opacity="0.5"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="3"
                                            Padding="6,2"
                                            FontSize="12"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{x:Bind Id}"
                                            Click="DeleteFinding_Click"
                                            ToolTipService.ToolTip="{x:Bind DeleteTooltip}"
                                            Visibility="{x:Bind HasId, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </Grid>

                                <TextBlock Text="{x:Bind Target}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Opacity="0.75"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Text="{x:Bind Evidence}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           MaxLines="4"
                                           Opacity="0.85" />

                                <TextBlock Text="{x:Bind Recommendation}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Opacity="0.7" />

                                <TextBlock Text="{x:Bind Reference}"
                                           FontSize="11"
                                           Opacity="0.6"
                                           Visibility="{x:Bind HasReference, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
