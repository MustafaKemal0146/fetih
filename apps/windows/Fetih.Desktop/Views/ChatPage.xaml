<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fetih.Desktop.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Fetih.Desktop.Models"
    xmlns:services="using:Fetih.Desktop.Services"
    xmlns:views="using:Fetih.Desktop.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            Mesaj eylemi düğmeleri: görünürlük mesajın ROLÜNE, etiket ve ipucu
            ise eylemin adına göre çözülür (bkz. ChatPage.xaml.cs).
        -->
        <views:ChatActionVisibilityConverter x:Key="ChatActionVisibilityConverter" />
        <views:ChatActionLabelConverter x:Key="ChatActionLabelConverter" />
    </Page.Resources>

    <Grid Padding="20,12,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Bağlantı durumu rozeti -->
        <Border Grid.Row="0"
                Padding="12,8"
                CornerRadius="6"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    Sohbet şeridindeki nokta da başlık çubuğu rozetiyle AYNI
                    kaynaktan boyanır. Sabit sarı kaldığında iki gösterge aynı
                    anda farklı şey söylüyordu: rozet "Model hatası", şerit
                    hâlâ nötr sarı.
                -->
                <Ellipse x:Name="StatusDot"
                         Grid.Column="0"
                         Width="10"
                         Height="10"
                         VerticalAlignment="Center"
                         AutomationProperties.AutomationId="chat_status_dot"
                         Fill="{x:Bind Status.BadgeBrush, Mode=OneWay}" />

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{x:Bind Status.StateLabel, Mode=OneWay}" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Opacity="0.65"
                           TextTrimming="CharacterEllipsis"
                           Text="{x:Bind Status.Detail, Mode=OneWay}" />

                <ProgressRing Grid.Column="3"
                              Width="16"
                              Height="16"
                              IsActive="{x:Bind Status.IsBusy, Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- Mesaj listesi -->
        <ListView x:Name="MessageList"
                  Grid.Row="1"
                  AutomationProperties.AutomationId="chat_messages"
                  ItemsSource="{x:Bind Messages}"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,3" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessage">
                    <!-- Baloncuk, role göre sağa/sola/ortaya yaslanır -->
                    <Grid HorizontalAlignment="{x:Bind BubbleAlignment}"
                          Margin="{x:Bind BubbleMargin}"
                          MaxWidth="720">
                        <!-- Normal mesaj baloncuğu (kullanıcı / asistan / sistem) -->
                        <Border Padding="14,10"
                                CornerRadius="{x:Bind BubbleCorner}"
                                Background="{x:Bind BubbleBrushKey, Converter={StaticResource ThemeBrushConverter}}"
                                BorderThickness="1"
                                BorderBrush="{x:Bind BubbleBorderBrushKey, Converter={StaticResource ThemeBrushConverter}}"
                                Visibility="{x:Bind IsBubble, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            Visibility="{x:Bind IsSystem, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                    <TextBlock Text="{x:Bind RoleLabel}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{x:Bind MetaBrushKey, Converter={StaticResource ThemeBrushConverter}}" />
                                    <TextBlock Text="{x:Bind TimeLabel}"
                                               FontSize="11"
                                               Foreground="{x:Bind MetaBrushKey, Converter={StaticResource ThemeBrushConverter}}"
                                               Opacity="0.8"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Düşünce Süreci (Reasoning / Thinking) Expander -->
                                <Expander IsExpanded="{x:Bind IsThoughtExpanded, Mode=TwoWay}"
                                          Visibility="{x:Bind ShowThoughtSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Margin="0,2,0,4">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ProgressRing Width="14" Height="14"
                                                          IsActive="{x:Bind IsThinking, Mode=OneWay}"
                                                          Visibility="{x:Bind IsThinking, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Text="{x:Bind ThoughtHeader, Mode=OneWay}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{x:Bind Thought, Mode=OneWay}"
                                                   FontSize="12"
                                                   FontFamily="Consolas"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </ScrollViewer>
                                </Expander>

                                <!--
                                    Asistan ve sistem mesajları güvenli markdown ile
                                    çizilir (bkz. Services/ChatMarkdown.cs). Kullanıcı
                                    mesajı düz metin kalır: kullanıcının yazdığı
                                    karakterler biçim olarak yorumlanmasın.
                                    Render edici bağlantı üretmez, görsel yüklemez.
                                -->
                                <services:ChatMarkdownView
                                    Markdown="{x:Bind Text, Mode=OneWay}"
                                    TextBrush="{x:Bind TextBrushKey, Converter={StaticResource ThemeBrushConverter}}"
                                    Visibility="{x:Bind IsUser, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />

                                <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           Foreground="{x:Bind TextBrushKey, Converter={StaticResource ThemeBrushConverter}}"
                                           Visibility="{x:Bind IsUser, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!--
                                    Mesaj eylemleri. Rol başına görünürlük:
                                    · Kopyala  → kullanıcı, ajan, sistem
                                    · Düzenle  → yalnızca kullanıcı
                                    · Yeniden dene → kullanıcı, ajan
                                -->
                                <StackPanel Orientation="Horizontal"
                                            Spacing="2"
                                            Margin="0,2,-4,-4"
                                            HorizontalAlignment="Right">
                                    <Button Click="CopyMessage_Click"
                                            Padding="6,2"
                                            FontSize="11"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{x:Bind MetaBrushKey, Converter={StaticResource ThemeBrushConverter}}"
                                            AutomationProperties.AutomationId="chat_action_copy"
                                            Content="{x:Bind Role, Converter={StaticResource ChatActionLabelConverter}, ConverterParameter=copy}"
                                            ToolTipService.ToolTip="{x:Bind Role, Converter={StaticResource ChatActionLabelConverter}, ConverterParameter=copy.hint}"
                                            Visibility="{x:Bind Role, Converter={StaticResource ChatActionVisibilityConverter}, ConverterParameter=User|Agent|System}" />

                                    <Button Click="EditMessage_Click"
                                            Padding="6,2"
                                            FontSize="11"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{x:Bind MetaBrushKey, Converter={StaticResource ThemeBrushConverter}}"
                                            AutomationProperties.AutomationId="chat_action_edit"
                                            Content="{x:Bind Role, Converter={StaticResource ChatActionLabelConverter}, ConverterParameter=edit}"
                                            ToolTipService.ToolTip="{x:Bind Role, Converter={StaticResource ChatActionLabelConverter}, ConverterParameter=edit.hint}"
                                            Visibility="{x:Bind Role, Converter={StaticResource ChatActionVisibilityConverter}, ConverterParameter=User}" />

                                    <Button Click="RetryMessage_Click"
                                            Padding="6,2"
                                            FontSize="11"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{x:Bind MetaBrushKey, Converter={StaticResource ThemeBrushConverter}}"
                                            AutomationProperties.AutomationId="chat_action_retry"
                                            Content="{x:Bind Role, Converter={StaticResource ChatActionLabelConverter}, ConverterParameter=retry}"
                                            ToolTipService.ToolTip="{x:Bind Role, Converter={StaticResource ChatActionLabelConverter}, ConverterParameter=retry.hint}"
                                            Visibility="{x:Bind Role, Converter={StaticResource ChatActionVisibilityConverter}, ConverterParameter=User|Agent}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Araç-kullanım kartı (session.tool_call / tool_result) -->
                        <Border Padding="12,10"
                                CornerRadius="{x:Bind BubbleCorner}"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                Visibility="{x:Bind IsTool, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing Width="14" Height="14"
                                                  IsActive="{x:Bind IsRunning, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ToolHeader, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                    <TextBlock Text="{x:Bind TimeLabel}"
                                               FontSize="12"
                                               Opacity="0.5"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ToolArguments}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Opacity="0.7"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                                <TextBlock Text="{x:Bind ToolResult, Mode=OneWay}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Opacity="0.85"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           Visibility="{x:Bind HasToolResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- Araç kartı da panoya kopyalanabilir (ad + argüman + sonuç). -->
                                <Button Click="CopyMessage_Click"
                                        Padding="6,2"
                                        FontSize="11"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Right"
                                        AutomationProperties.AutomationId="chat_tool_copy"
                                        Content="{x:Bind Role, Converter={StaticResource ChatActionLabelConverter}, ConverterParameter=copy}"
                                        ToolTipService.ToolTip="{x:Bind Role, Converter={StaticResource ChatActionLabelConverter}, ConverterParameter=copy.hint}"
                                        Visibility="{x:Bind Role, Converter={StaticResource ChatActionVisibilityConverter}, ConverterParameter=Tool}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Giriş kutusu: Enter yeni satır, Ctrl+Enter gönderir -->
        <Grid Grid.Row="2" ColumnSpacing="8" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PromptBox"
                     Grid.Row="0"
                     Grid.Column="0"
                     AutomationProperties.AutomationId="chat_input"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="60"
                     MaxHeight="160"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     TextChanged="PromptBox_TextChanged"
                     KeyDown="PromptBox_KeyDown" />

            <Button x:Name="SendButton"
                    Grid.Row="0"
                    Grid.Column="1"
                    MinWidth="96"
                    VerticalAlignment="Bottom"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="chat_send"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SendButton_Click" />

            <!--
                Tur sürerken Gönder'in YERİNE geçer (aynı hücre): üretim
                iptal edilebilir olsun diye. Görünürlüğü UpdateSendButton
                yönetir.
            -->
            <Button x:Name="StopButton"
                    Grid.Row="0"
                    Grid.Column="1"
                    MinWidth="96"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="chat_stop"
                    Click="StopButton_Click" />

            <TextBlock x:Name="HintText"
                       Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       FontSize="11"
                       Opacity="0.5" />
        </Grid>
    </Grid>
</Page>
