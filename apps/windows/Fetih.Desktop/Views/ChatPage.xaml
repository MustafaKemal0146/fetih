<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fetih.Desktop.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Fetih.Desktop.Models"
    xmlns:controls="using:Fetih.Desktop.Controls"
    xmlns:services="using:Fetih.Desktop.Services"
    xmlns:views="using:Fetih.Desktop.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <views:ChatActionVisibilityConverter x:Key="ChatActionVisibilityConverter" />
        <views:ChatActionLabelConverter x:Key="ChatActionLabelConverter" />

        <!-- User Message Template -->
        <DataTemplate x:Key="UserTemplate" x:DataType="models:ChatMessage">
            <Grid Margin="16,4" HorizontalAlignment="Right" MaxWidth="680">
                <Border Padding="14,10"
                        CornerRadius="16,16,4,16"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <Button Click="CopyMessage_Click"
                                    Padding="4,2"
                                    FontSize="11"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                                    Content="{x:Bind Role, Converter={StaticResource ChatActionLabelConverter}, ConverterParameter=copy}" />
                            <Button Click="EditMessage_Click"
                                    Padding="4,2"
                                    FontSize="11"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                                    Content="{x:Bind Role, Converter={StaticResource ChatActionLabelConverter}, ConverterParameter=edit}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Assistant Message Template — OpenClaw tarzı: sol avatar + saydam geniş kart -->
        <DataTemplate x:Key="AgentTemplate" x:DataType="models:ChatMessage">
            <Grid Margin="16,6" HorizontalAlignment="Left" MaxWidth="820" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Avatar (marka baş harfi; glyph riski olmasın diye metin) -->
                <Border Grid.Column="0"
                        Width="32" Height="32"
                        CornerRadius="16"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="F"
                               FontWeight="Bold"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>

                <!-- Saydam geniş kart (baloncuk değil) -->
                <Border Grid.Column="1"
                        Padding="14,10"
                        CornerRadius="12"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <services:ChatMarkdownView Markdown="{x:Bind Text, Mode=OneWay}"
                                                   TextBrush="{ThemeResource TextFillColorPrimaryBrush}" />
                        <ProgressRing IsActive="{x:Bind IsStreaming, Mode=OneWay}"
                                      Width="14" Height="14"
                                      Visibility="{x:Bind IsStreaming, Mode=OneWay}"
                                      HorizontalAlignment="Left" />

                        <!-- Footer: saat · kopyala · yeniden dene (akış bitince) -->
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left"
                                    Visibility="{x:Bind IsStreaming, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                            <TextBlock Text="{x:Bind TimeLabel}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="·"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Button Click="CopyMessage_Click"
                                    Padding="4,2"
                                    FontSize="11"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Content="{x:Bind Role, Converter={StaticResource ChatActionLabelConverter}, ConverterParameter=copy}" />
                            <Button Click="RetryMessage_Click"
                                    Padding="4,2"
                                    FontSize="11"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Content="{x:Bind Role, Converter={StaticResource ChatActionLabelConverter}, ConverterParameter=retry}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Step Thought Template (Inside ActivityGroup) -->
        <DataTemplate x:Key="StepThoughtTemplate" x:DataType="models:ChatMessage">
            <Border Margin="0,4" Padding="4,2">
                <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
        </DataTemplate>

        <!-- Step Tool Template (Inside ActivityGroup) -->
        <DataTemplate x:Key="StepToolTemplate" x:DataType="models:ChatMessage">
            <Grid Margin="0,4">
                <Expander HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing Width="12" Height="12"
                                          IsActive="{x:Bind IsRunning, Mode=OneWay}"
                                          Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                            <FontIcon Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontSize="12"
                                      Visibility="{x:Bind IsNotRunning, Mode=OneWay}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ToolTitle, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Duration, Mode=OneWay}"
                                           FontSize="10"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                           FontSize="10"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="4">
                        <Border Background="{ThemeResource LayerFillColorAltBrush}"
                                CornerRadius="4"
                                Padding="6"
                                Visibility="{x:Bind HasInput, Mode=OneWay}">
                            <ScrollViewer MaxHeight="160" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{x:Bind ToolInput, Mode=OneWay}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </Border>
                        <Border Background="{ThemeResource LayerFillColorAltBrush}"
                                CornerRadius="4"
                                Padding="6"
                                Visibility="{x:Bind HasOutput, Mode=OneWay}">
                            <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{x:Bind ToolOutput, Mode=OneWay}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Expander>
            </Grid>
        </DataTemplate>

        <views:StepTemplateSelector x:Key="StepSelector"
                                    Thought="{StaticResource StepThoughtTemplate}"
                                    Tool="{StaticResource StepToolTemplate}" />

        <!-- Claude-style Consolidated Activity Card Template -->
        <DataTemplate x:Key="ActivityTemplate" x:DataType="models:ActivityGroup">
            <Grid Margin="16,2" HorizontalAlignment="Left" MaxWidth="780">
                <StackPanel Spacing="2">
                    <!-- Entire Header Row as Clickable Button -->
                    <Button Click="ToggleGroup_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="6,4"
                            CornerRadius="4"
                            Background="Transparent"
                            BorderThickness="0"
                            AutomationProperties.Name="{x:Bind SummaryText, Mode=OneWay}">
                        <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Status Icon (Only when done) -->
                            <FontIcon Grid.Column="0"
                                      Glyph="{x:Bind HeaderGlyph, Mode=OneWay}"
                                      FontSize="13"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center"
                                      Visibility="{x:Bind IsDone, Mode=OneWay}" />

                            <!-- Middle: Text & Live Timer -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <!-- Running state: PulseText + Live Timer -->
                                <controls:PulseText Text="{x:Bind Label, Mode=OneWay}"
                                                    IsActive="{x:Bind IsRunning, Mode=OneWay}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ElapsedText, Mode=OneWay}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind IsRunning, Mode=OneWay}" />

                                <!-- Done state: Summary text (Label + Actions + Duration) -->
                                <TextBlock Text="{x:Bind SummaryText, Mode=OneWay}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind IsDone, Mode=OneWay}" />
                            </StackPanel>

                            <!-- Right: Chevron (0 deg closed, 90 deg open) -->
                            <FontIcon Grid.Column="2"
                                      Glyph="&#xE76C;"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform>
                                    <RotateTransform Angle="{x:Bind ChevronAngle, Mode=OneWay}" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </Grid>
                    </Button>

                    <!-- Collapsible Step Details (With 2px vertical border on left) -->
                    <Border Visibility="{x:Bind IsExpanded, Mode=OneWay}"
                            Margin="6,2,0,4"
                            Padding="14,0,0,0"
                            BorderThickness="2,0,0,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <ScrollViewer MaxHeight="320"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      PointerWheelChanged="ActivityScrollViewer_PointerWheelChanged">
                            <ItemsControl ItemsSource="{x:Bind Steps}"
                                          ItemTemplateSelector="{StaticResource StepSelector}" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Approval Card Template (dangerous command → user consent) -->
        <DataTemplate x:Key="ApprovalTemplate" x:DataType="models:ChatMessage">
            <Grid Margin="16,6" HorizontalAlignment="Left" MaxWidth="780">
                <Border Padding="14,12"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource SystemFillColorCautionBrush}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;"
                                      FontSize="16"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ApprovalTitle}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{x:Bind ApprovalDescription}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind HasApprovalDescription}" />

                        <Border Background="{ThemeResource LayerFillColorAltBrush}"
                                CornerRadius="6"
                                Padding="8">
                            <ScrollViewer MaxHeight="140"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{x:Bind ApprovalCommand}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </Border>

                        <!-- Action buttons (while pending) -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind ApprovalPending, Mode=OneWay}">
                            <Button Click="ApprovalAllowOnce_Click"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Content="{x:Bind ApprovalAllowOnceLabel}" />
                            <Button Click="ApprovalAllowSession_Click"
                                    Content="{x:Bind ApprovalAllowSessionLabel}" />
                            <Button Click="ApprovalAllowAlways_Click"
                                    Content="{x:Bind ApprovalAllowAlwaysLabel}" />
                            <Button Click="ApprovalDeny_Click"
                                    Content="{x:Bind ApprovalDenyLabel}" />
                        </StackPanel>

                        <!-- Outcome (after resolution) -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    Visibility="{x:Bind HasApprovalOutcome, Mode=OneWay}">
                            <FontIcon Glyph="&#xE73E;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ApprovalOutcome, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- System Message Template -->
        <DataTemplate x:Key="SystemTemplate" x:DataType="models:ChatMessage">
            <Border HorizontalAlignment="Center" Margin="16,4" Padding="12,6"
                    CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </Border>
        </DataTemplate>

        <!-- Root Chat Selector -->
        <views:ChatTemplateSelector x:Key="ChatSelector"
                                    User="{StaticResource UserTemplate}"
                                    Agent="{StaticResource AgentTemplate}"
                                    Thought="{StaticResource StepThoughtTemplate}"
                                    Tool="{StaticResource StepToolTemplate}"
                                    Activity="{StaticResource ActivityTemplate}"
                                    Approval="{StaticResource ApprovalTemplate}"
                                    System="{StaticResource SystemTemplate}" />
    </Page.Resources>

    <!-- Main Content Area: Full Width Chat -->
    <Grid Padding="20,12,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top: Connection status badge -->
        <Border Grid.Row="0"
                Padding="12,8"
                CornerRadius="6"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusDot"
                         Grid.Column="0"
                         Width="10"
                         Height="10"
                         VerticalAlignment="Center"
                         Fill="{x:Bind Status.BadgeBrush, Mode=OneWay}" />

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Opacity="0.8"
                           TextTrimming="CharacterEllipsis"
                           Text="{x:Bind Status.Detail, Mode=OneWay}" />

                <ProgressRing Grid.Column="2"
                              Width="16"
                              Height="16"
                              IsActive="{x:Bind Status.IsBusy, Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- Middle: Messages Flow + Empty State -->
        <Grid Grid.Row="1">
            <!-- Empty State Overlay -->
            <StackPanel x:Name="EmptyStatePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="Collapsed">
                <FontIcon Glyph="&#xE768;" FontSize="42" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock x:Name="EmptyStateTitle"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyStateDesc"
                           FontSize="13"
                           Opacity="0.6"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Messages Stream -->
            <ScrollViewer x:Name="Scroller"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl x:Name="MessageItems"
                                  ItemsSource="{x:Bind Messages}"
                                  ItemTemplateSelector="{StaticResource ChatSelector}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom: Input box, Send & Stop buttons -->
        <Grid Grid.Row="2" ColumnSpacing="8" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PromptBox"
                     Grid.Row="0"
                     Grid.Column="0"
                     AutomationProperties.AutomationId="chat_input"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="60"
                     MaxHeight="160"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     TextChanged="PromptBox_TextChanged"
                     KeyDown="PromptBox_KeyDown" />

            <Button x:Name="SendButton"
                    Grid.Row="0"
                    Grid.Column="1"
                    MinWidth="96"
                    VerticalAlignment="Bottom"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="chat_send"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SendButton_Click">
                <FontIcon Glyph="&#xE724;" />
            </Button>

            <Button x:Name="StopButton"
                    Grid.Row="0"
                    Grid.Column="1"
                    MinWidth="96"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="chat_stop"
                    Click="StopButton_Click">
                <FontIcon Glyph="&#xE71A;" />
            </Button>

            <TextBlock x:Name="HintText"
                       Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       FontSize="11"
                       Opacity="0.5" />
        </Grid>
    </Grid>
</Page>
