<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fetih.Desktop.Views.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Fetih.Desktop.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Dosya ağacı + önizleme/diff (issue #43). Sol: çalışma alanı ağacı
        (file.tree ile tembel yüklenir). Sağ: seçili dosyanın önizlemesi
        (file.read) veya git değişikliği (file.diff). Tümü çalışma alanı
        köküne kısıtlıdır (köprü tarafında doğrulanır).
    -->
    <Grid Padding="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sol: ağaç -->
        <Grid Grid.Column="0" Padding="12,14,8,12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           x:Name="TreeTitle"
                           FontWeight="SemiBold"
                           FontSize="15"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        x:Name="ReloadButton"
                        Padding="8,4"
                        FontSize="12"
                        AutomationProperties.AutomationId="files_reload"
                        Click="ReloadButton_Click" />
            </Grid>

            <TreeView Grid.Row="1"
                      x:Name="Tree"
                      AutomationProperties.AutomationId="files_tree"
                      SelectionMode="Single"
                      Expanding="Tree_Expanding"
                      ItemInvoked="Tree_ItemInvoked">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="models:FileNode">
                        <TreeViewItem AutomationProperties.Name="{x:Bind Name}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" VerticalAlignment="Center" Opacity="0.85" />
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <Border Grid.Column="1" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

        <!-- Sağ: önizleme / diff -->
        <Grid Grid.Column="2" Padding="16,14,16,12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock x:Name="PathText"
                           FontFamily="Consolas"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           Opacity="0.9" />
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="PreviewButton"
                                Padding="12,4"
                                FontSize="12"
                                AutomationProperties.AutomationId="files_preview"
                                Click="PreviewButton_Click" />
                        <Button x:Name="DiffButton"
                                Padding="12,4"
                                FontSize="12"
                                AutomationProperties.AutomationId="files_diff"
                                Click="DiffButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="NoteText"
                               FontSize="11"
                               Opacity="0.65"
                               VerticalAlignment="Center" />
                    <ProgressRing x:Name="BusyRing"
                                  Width="16" Height="16"
                                  IsActive="False"
                                  VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1">
                <TextBlock x:Name="EmptySelection"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.55"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <!-- Önizleme: salt okunur, tek aralıklı -->
                <TextBox x:Name="PreviewBox"
                         IsReadOnly="True"
                         IsSpellCheckEnabled="False"
                         FontFamily="Consolas"
                         FontSize="12.5"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Visibility="Collapsed" />

                <!-- Diff: satır bazlı renklendirme -->
                <ScrollViewer x:Name="DiffScroller"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Enabled"
                              Visibility="Collapsed">
                    <StackPanel x:Name="DiffHost" Padding="2" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
