<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fetih.Desktop.Views.Settings.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock x:Name="TitleText" Text="Kabuk (Windows)" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:Name="IntroText" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>

            <InfoBar x:Name="StatusBar"
                     IsOpen="False"
                     IsClosable="True" />

            <ProgressRing x:Name="BusyRing" IsActive="False" HorizontalAlignment="Left" />

            <!-- Kabuk seçici -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <RadioButton x:Name="GitBashRadio"
                                 AutomationProperties.AutomationId="shell_git_bash"
                                 GroupName="ShellBackend"
                                 Checked="Backend_Checked">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="GitBashTitle" FontWeight="SemiBold" Text="Git Bash" />
                            <TextBlock x:Name="GitBashDesc"
                                       FontSize="12"
                                       Opacity="0.7"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="GitBashPath"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Opacity="0.5"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="WslRadio"
                                 AutomationProperties.AutomationId="shell_wsl"
                                 GroupName="ShellBackend"
                                 Checked="Backend_Checked">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="WslTitle" FontWeight="SemiBold" Text="WSL" />
                            <TextBlock x:Name="WslDesc"
                                       FontSize="12"
                                       Opacity="0.7"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>

                    <StackPanel x:Name="WslDetailPanel" Spacing="10" Margin="28,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="DistroLabel"
                                       Text="Dağıtım"
                                       VerticalAlignment="Center"
                                       FontSize="13" />
                            <ComboBox x:Name="DistroCombo"
                                      MinWidth="240"
                                      AutomationProperties.AutomationId="shell_wsl_distro"
                                      SelectionChanged="DistroCombo_SelectionChanged" />
                        </StackPanel>

                        <TextBlock x:Name="WslMissingText"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />

                        <Border Padding="12"
                                CornerRadius="6"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="CreateUserDesc"
                                           FontSize="12"
                                           Opacity="0.75"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="CreateUserButton"
                                            AutomationProperties.AutomationId="shell_create_user"
                                            Click="CreateUserButton_Click" />
                                    <TextBlock x:Name="CreateUserStatus"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Opacity="0.85" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="EffectiveText"
                               FontSize="12"
                               Opacity="0.6"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
