<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fetih.Desktop.Views.Settings.BridgePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer AutomationProperties.AutomationId="bridge_scroll"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Enabled">
        <StackPanel Padding="24,16,24,32" Spacing="16" MaxWidth="920" HorizontalAlignment="Left">

            <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock x:Name="IntroText" Style="{StaticResource MutedTextStyle}" />

            <!-- Canlı durum -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0"
                             Width="12"
                             Height="12"
                             VerticalAlignment="Center"
                             Fill="{ThemeResource SystemFillColorCautionBrush}" />

                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock FontWeight="SemiBold"
                                   FontSize="15"
                                   Text="{x:Bind Status.StateLabel, Mode=OneWay}" />
                        <TextBlock Opacity="0.7"
                                   TextWrapping="Wrap"
                                   Text="{x:Bind Status.Detail, Mode=OneWay}" />
                    </StackPanel>

                    <ProgressRing Grid.Column="2"
                                  Width="20"
                                  Height="20"
                                  IsActive="{x:Bind Status.IsBusy, Mode=OneWay}" />
                </Grid>
            </Border>

            <!-- Taşıma yapılandırması -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock x:Name="TransportHeader" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ItemsControl x:Name="TransportRows" ItemTemplate="{StaticResource SettingRowTemplate}" />
                </StackPanel>
            </Border>

            <!-- Çözümlenen yollar -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock x:Name="PathsHeader" Style="{StaticResource SectionHeaderTextStyle}" />
                    <TextBlock x:Name="PathsNoteText"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,0,0,6" />
                    <ItemsControl x:Name="PathRows" ItemTemplate="{StaticResource SettingRowTemplate}" />
                </StackPanel>
            </Border>

            <!-- Faz notu -->
            <InfoBar x:Name="PhaseInfo"
                     IsOpen="True"
                     IsClosable="False"
                     Severity="Informational" />

            <Button x:Name="RefreshButton"
                    AutomationProperties.AutomationId="bridge_refresh"
                    Click="RefreshButton_Click" />
        </StackPanel>
    </ScrollViewer>
</Page>
