<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fetih.Desktop.Views.Settings.SandboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer AutomationProperties.AutomationId="sandbox_scroll"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Enabled">
        <StackPanel Padding="24,16,24,32" Spacing="16" MaxWidth="940" HorizontalAlignment="Left">

            <TextBlock Text="Sandbox" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Style="{StaticResource MutedTextStyle}"
                       Text="Araçların hangi yürütme ortamında çalıştığı. FETİH'te bu ayar config.yaml'daki terminal.backend anahtarıdır: yerel kabuktan tam izole konteynere kadar." />

            <InfoBar x:Name="BackendInfo"
                     IsOpen="True"
                     IsClosable="False"
                     Severity="Informational"
                     Title="Etkin arka uç" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Yürütme ortamı" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ItemsControl x:Name="BackendRows" ItemTemplate="{StaticResource SettingRowTemplate}" />
                </StackPanel>
            </Border>

            <Border x:Name="ContainerCard" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Konteyner kaynak sınırları" Style="{StaticResource SectionHeaderTextStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Margin="0,0,0,6"
                               Text="docker, singularity, modal, daytona ve vercel_sandbox arka uçlarında geçerlidir; local ve ssh için yok sayılır." />
                    <ItemsControl x:Name="ContainerRows" ItemTemplate="{StaticResource SettingRowTemplate}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="İzolasyon ve paylaşım" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ItemsControl x:Name="IsolationRows" ItemTemplate="{StaticResource SettingRowTemplate}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Kod çalıştırma ve çıktı sınırları" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ItemsControl x:Name="ExecutionRows" ItemTemplate="{StaticResource SettingRowTemplate}" />
                </StackPanel>
            </Border>

            <Button x:Name="RefreshButton"
                    Content="Yeniden oku"
                    AutomationProperties.AutomationId="sandbox_refresh"
                    Click="RefreshButton_Click" />
        </StackPanel>
    </ScrollViewer>
</Page>
