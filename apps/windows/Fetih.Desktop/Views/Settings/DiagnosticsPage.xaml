<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fetih.Desktop.Views.Settings.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Tanılama" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Style="{StaticResource MutedTextStyle}"
                       Text="Destek istenirken ilk bakılacak yer: çalışma zamanı bilgisi, çözümlenen yollar ve çökme günlüğü." />
        </StackPanel>

        <!-- Üst blok: sistem bilgisi + yollar yan yana -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Sistem bilgisi" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ItemsControl x:Name="SystemRows" ItemTemplate="{StaticResource SettingRowTemplate}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Çözümlenen yollar" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ItemsControl x:Name="PathRows" ItemTemplate="{StaticResource SettingRowTemplate}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Çökme günlüğü -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Çökme günlüğü" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock x:Name="CrashLogMeta"
                                   FontSize="12"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Yenile"
                            AutomationProperties.AutomationId="diagnostics_refresh"
                            Click="RefreshButton_Click" />
                    <Button Grid.Column="2"
                            Content="Panoya kopyala"
                            AutomationProperties.AutomationId="diagnostics_copy"
                            Click="CopyButton_Click" />
                    <Button Grid.Column="3"
                            Content="Günlüğü temizle"
                            AutomationProperties.AutomationId="diagnostics_clear"
                            Click="ClearButton_Click" />
                </Grid>

                <InfoBar x:Name="ActionInfo"
                         Grid.Row="1"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Success" />

                <TextBox x:Name="CrashLogText"
                         Grid.Row="2"
                         AutomationProperties.AutomationId="diagnostics_log"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="12"
                         MinHeight="180"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
    </Grid>
</Page>
