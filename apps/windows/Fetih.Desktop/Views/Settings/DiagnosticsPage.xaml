<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fetih.Desktop.Views.Settings.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        SORUN 1: sayfa daha önce kök bir Grid'di ve "Çökme günlüğü" kartı
        yıldız (*) satırdaydı; pencere varsayılan boyuttayken kart ekranın
        altında kalıyor, kullanıcı pencereyi büyütmek zorunda kalıyordu.
        Artık kök bir ScrollViewer var, tüm satırlar Auto yükseklikte ve
        günlük kutusunun sabit bir yüksekliği var — pencere ne kadar küçük
        olursa olsun en alttaki "Günlüğü temizle" düğmesine kaydırarak
        erişilebilir.
    -->
    <ScrollViewer AutomationProperties.AutomationId="diagnostics_scroll"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Enabled">
        <Grid Padding="24,16,24,32" RowSpacing="12" MaxWidth="1000" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Tanılama" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Style="{StaticResource MutedTextStyle}"
                           Text="Destek istenirken ilk bakılacak yer: çalışma zamanı bilgisi, çözümlenen yollar ve çökme günlüğü." />
            </StackPanel>

            <!--
                Üst blok: sistem bilgisi ve çözümlenen yollar. Eskiden yan yana
                iki sütundaydı; satır şablonunun 240 px sabit etiket sütunu
                yüzünden değer sütunu ~100 px'e düşüyor ve uzun Windows yolları
                harf harf sarılıyordu. Artık alt alta, tam genişlikte.
            -->
            <StackPanel Grid.Row="1" Spacing="12">
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Sistem bilgisi" Style="{StaticResource SectionHeaderTextStyle}" />
                        <ItemsControl x:Name="SystemRows" ItemTemplate="{StaticResource SettingRowTemplate}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Çözümlenen yollar" Style="{StaticResource SectionHeaderTextStyle}" />
                        <ItemsControl x:Name="PathRows" ItemTemplate="{StaticResource SettingRowTemplate}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Çökme günlüğü -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Çökme günlüğü" Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock x:Name="CrashLogMeta"
                                       FontSize="12"
                                       Opacity="0.6"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Yenile"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="diagnostics_refresh"
                                Click="RefreshButton_Click" />
                        <Button Grid.Column="2"
                                Content="Panoya kopyala"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="diagnostics_copy"
                                Click="CopyButton_Click" />
                        <Button Grid.Column="3"
                                Content="Günlüğü temizle"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="diagnostics_clear"
                                Click="ClearButton_Click" />
                    </Grid>

                    <InfoBar x:Name="ActionInfo"
                             IsOpen="False"
                             IsClosable="True"
                             Severity="Success" />

                    <!--
                        Sabit yükseklik: ScrollViewer içindeki bir TextBox
                        "*" yükseklik alamaz, aksi hâlde sonsuz büyür.
                    -->
                    <TextBox x:Name="CrashLogText"
                             AutomationProperties.AutomationId="diagnostics_log"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="12"
                             Height="300"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
