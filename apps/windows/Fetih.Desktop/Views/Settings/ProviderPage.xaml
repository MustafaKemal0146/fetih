<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fetih.Desktop.Views.Settings.ProviderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Fetih.Desktop.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Model ve Sağlayıcı" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Style="{StaticResource MutedTextStyle}"
                       Text="FETİH model-agnostiktir. Aşağıdaki liste desteklenen sağlayıcıları ve her biri için gereken ortam değişkenlerinin tanımlı olup olmadığını gösterir. Güvenlik gereği anahtar değerleri asla okunmaz veya gösterilmez." />
        </StackPanel>

        <!-- Aktif model -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Etkin yapılandırma" Style="{StaticResource SectionHeaderTextStyle}" />
                <ItemsControl x:Name="ActiveRows" ItemTemplate="{StaticResource SettingRowTemplate}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="SearchBox"
                     MinWidth="280"
                     AutomationProperties.AutomationId="provider_search"
                     PlaceholderText="Sağlayıcı ara…"
                     TextChanged="SearchBox_TextChanged" />
            <CheckBox x:Name="OnlyConfiguredBox"
                      Content="Yalnızca kimlik bilgisi tanımlı olanlar"
                      AutomationProperties.AutomationId="provider_only_configured"
                      Checked="Filter_Changed"
                      Unchecked="Filter_Changed" />
            <TextBlock x:Name="CountText"
                       VerticalAlignment="Center"
                       Style="{StaticResource MutedTextStyle}" />
        </StackPanel>

        <ListView Grid.Row="3"
                  x:Name="ProviderList"
                  AutomationProperties.AutomationId="provider_list"
                  SelectionMode="None"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,3" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ProviderRow">
                    <Border Padding="14,12"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse Width="10"
                                         Height="10"
                                         VerticalAlignment="Center"
                                         Fill="{x:Bind StatusBrushKey, Converter={StaticResource ThemeBrushConverter}}" />
                                <TextBlock Text="{x:Bind DisplayName}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border Padding="6,1"
                                        CornerRadius="4"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Etkin"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="{x:Bind Badges}"
                                           FontSize="11"
                                           Opacity="0.6"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind HasBadges, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind MetaLine}"
                                       FontSize="12"
                                       Opacity="0.6" />

                            <ItemsControl ItemsSource="{x:Bind Keys}"
                                          Visibility="{x:Bind HasKeys, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:EnvKeyRow">
                                        <Grid ColumnSpacing="10" Padding="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0"
                                                     Width="8"
                                                     Height="8"
                                                     VerticalAlignment="Center"
                                                     Fill="{x:Bind StatusBrushKey, Converter={StaticResource ThemeBrushConverter}}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind VariableName}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind StatusLabel}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{x:Bind SourceLabel}"
                                                       FontSize="12"
                                                       Opacity="0.6"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
