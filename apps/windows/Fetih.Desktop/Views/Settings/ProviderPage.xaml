<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fetih.Desktop.Views.Settings.ProviderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Fetih.Desktop.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Model ve Sağlayıcı" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Style="{StaticResource MutedTextStyle}"
                       Text="FETİH model-agnostiktir. Aşağıdaki liste desteklenen sağlayıcıları ve her biri için gereken ortam değişkenlerinin tanımlı olup olmadığını gösterir. Güvenlik gereği anahtar değerleri asla okunmaz veya gösterilmez." />
        </StackPanel>

        <!-- Aktif model + düzenleyici -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="4">
                <TextBlock Text="Etkin yapılandırma" Style="{StaticResource SectionHeaderTextStyle}" />
                <ItemsControl x:Name="ActiveRows" ItemTemplate="{StaticResource SettingRowTemplate}" />

                <!-- Görev G: etkin model/sağlayıcıyı buradan değiştir (config.set) -->
                <TextBlock Text="Etkin modeli değiştir"
                           Style="{StaticResource SectionHeaderTextStyle}"
                           Margin="0,12,0,0" />
                <TextBlock Style="{StaticResource MutedTextStyle}"
                           FontSize="12"
                           Text="Sağlayıcıyı ara ve seç, model kimliğini gir. Kaydettiğinde config.set ile ~/.fetih/config.yaml'a yazılır ve bir sonraki mesajda etkili olur. API anahtarı ~/.fetih/.env içinde tanımlı olmalıdır." />

                <Grid ColumnSpacing="10" RowSpacing="8" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Sağlayıcı"
                               VerticalAlignment="Center"
                               Width="80" />
                    <AutoSuggestBox Grid.Row="0" Grid.Column="1"
                                    x:Name="ProviderSelectBox"
                                    AutomationProperties.AutomationId="provider_select"
                                    PlaceholderText="Sağlayıcı ara (ör. groq, anthropic)…"
                                    TextChanged="ProviderSelectBox_TextChanged"
                                    SuggestionChosen="ProviderSelectBox_SuggestionChosen" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Model"
                               VerticalAlignment="Center"
                               Width="80" />
                    <TextBox Grid.Row="1" Grid.Column="1"
                             x:Name="ModelBox"
                             AutomationProperties.AutomationId="provider_model"
                             PlaceholderText="Model kimliği (ör. llama-3.3-70b-versatile)" />

                    <StackPanel Grid.Row="2" Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10">
                        <Button x:Name="SaveModelButton"
                                Content="Kaydet"
                                AutomationProperties.AutomationId="provider_save"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="SaveModelButton_Click" />
                        <TextBlock x:Name="SaveModelStatus"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.85" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="SearchBox"
                     MinWidth="280"
                     AutomationProperties.AutomationId="provider_search"
                     PlaceholderText="Sağlayıcı ara…"
                     TextChanged="SearchBox_TextChanged" />
            <CheckBox x:Name="OnlyConfiguredBox"
                      Content="Yalnızca kimlik bilgisi tanımlı olanlar"
                      AutomationProperties.AutomationId="provider_only_configured"
                      Checked="Filter_Changed"
                      Unchecked="Filter_Changed" />
            <TextBlock x:Name="CountText"
                       VerticalAlignment="Center"
                       Style="{StaticResource MutedTextStyle}" />
        </StackPanel>

        <ListView Grid.Row="3"
                  x:Name="ProviderList"
                  AutomationProperties.AutomationId="provider_list"
                  SelectionMode="None"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,3" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ProviderRow">
                    <Border Padding="14,12"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse Width="10"
                                         Height="10"
                                         VerticalAlignment="Center"
                                         Fill="{x:Bind StatusBrushKey, Converter={StaticResource ThemeBrushConverter}}" />
                                <TextBlock Text="{x:Bind DisplayName}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border Padding="6,1"
                                        CornerRadius="4"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Etkin"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="{x:Bind Badges}"
                                           FontSize="11"
                                           Opacity="0.6"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind HasBadges, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind MetaLine}"
                                       FontSize="12"
                                       Opacity="0.6" />

                            <ItemsControl ItemsSource="{x:Bind Keys}"
                                          Visibility="{x:Bind HasKeys, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:EnvKeyRow">
                                        <Grid ColumnSpacing="10" Padding="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0"
                                                     Width="8"
                                                     Height="8"
                                                     VerticalAlignment="Center"
                                                     Fill="{x:Bind StatusBrushKey, Converter={StaticResource ThemeBrushConverter}}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind VariableName}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind StatusLabel}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{x:Bind SourceLabel}"
                                                       FontSize="12"
                                                       Opacity="0.6"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
