<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fetih.Desktop.Views.Settings.ProviderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Fetih.Desktop.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        SORUN 1: sayfanın kökü bir ScrollViewer. "Etkin yapılandırma" kartı
        yüksek olduğundan, küçük pencerede sağlayıcı listesi eskiden ekranın
        dışında kalıyordu. Liste kendi kaydırmasını devre dışı bırakır
        (aşağıdaki VerticalScrollMode="Disabled") ve tüm yüksekliğiyle
        çizilir; kaydırmayı tek bir dış ScrollViewer yönetir.
    -->
    <ScrollViewer AutomationProperties.AutomationId="provider_scroll"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Enabled">
    <Grid Padding="24,16,24,32" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource MutedTextStyle}" />
        </StackPanel>

        <!-- Aktif model + düzenleyici -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="4">
                <TextBlock x:Name="ActiveConfigHeader" Style="{StaticResource SectionHeaderTextStyle}" />
                <ItemsControl x:Name="ActiveRows" ItemTemplate="{StaticResource SettingRowTemplate}" />

                <!-- Görev G: etkin model/sağlayıcıyı buradan değiştir (config.set) -->
                <TextBlock x:Name="ChangeModelHeader"
                           Style="{StaticResource SectionHeaderTextStyle}"
                           Margin="0,12,0,0" />
                <TextBlock x:Name="ChangeModelDesc"
                           Style="{StaticResource MutedTextStyle}"
                           FontSize="12" />

                <Grid ColumnSpacing="10" RowSpacing="10" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               x:Name="ProviderLabel"
                               VerticalAlignment="Center"
                               Width="85" />
                    <AutoSuggestBox Grid.Row="0" Grid.Column="1"
                                    x:Name="ProviderSelectBox"
                                    AutomationProperties.AutomationId="provider_select"
                                    TextChanged="ProviderSelectBox_TextChanged"
                                    SuggestionChosen="ProviderSelectBox_SuggestionChosen" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               x:Name="ModelLabel"
                               VerticalAlignment="Center"
                               Width="85" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                        <ComboBox x:Name="ModelCombo"
                                  IsEditable="True"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.AutomationId="provider_model" />
                        <TextBlock x:Name="ModelHintText"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="11" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               x:Name="ApiKeyLabel"
                               VerticalAlignment="Center"
                               Width="85" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox Grid.Column="0"
                                         x:Name="ApiKeyBox"
                                         AutomationProperties.AutomationId="provider_api_key"
                                         PasswordRevealMode="Peek" />
                            <HyperlinkButton Grid.Column="1"
                                             x:Name="ApiKeySignupLink"
                                             Padding="4,2"
                                             VerticalAlignment="Center"
                                             Click="ApiKeySignupLink_Click" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Durum noktası süs: aynı bilgiyi ApiKeyStatusText taşıyor. -->
                            <Ellipse x:Name="ApiKeyStatusDot"
                                     Width="8"
                                     Height="8"
                                     VerticalAlignment="Center"
                                     AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="ApiKeyStatusText" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="ApiKeyEnvVarText" FontSize="11" FontFamily="Consolas" Opacity="0.7" VerticalAlignment="Center" />
                        </StackPanel>
                        <InfoBar x:Name="ProviderKindInfoBar"
                                 IsOpen="False"
                                 IsClosable="False"
                                 Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10">
                        <Button x:Name="SaveModelButton"
                                AutomationProperties.AutomationId="provider_save"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="SaveModelButton_Click" />
                        <TextBlock x:Name="SaveModelStatus"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.85" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!--
            FETİH'in TEK bir modeli yoktur: birincil model hata verdiğinde
            devreye giren bir yedek model ve yan görevler (görüntü çözümleme,
            bağlam sıkıştırma, onay kararı…) için 11 ayrı "yardımcı model
            yuvası" vardır. Bu kart o yuvaları — ve YALNIZCA gerçekten var olan
            config anahtarlarını — düzenlenebilir hâle getirir.
        -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="4">
                <TextBlock x:Name="SlotsTitle"
                           Style="{StaticResource SectionHeaderTextStyle}" />
                <TextBlock x:Name="SlotsIntro"
                           Style="{StaticResource MutedTextStyle}"
                           FontSize="12" />
                <StackPanel x:Name="SlotsHost" Spacing="4" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="SearchBox"
                     MinWidth="280"
                     AutomationProperties.AutomationId="provider_search"
                     TextChanged="SearchBox_TextChanged" />
            <CheckBox x:Name="OnlyConfiguredBox"
                      AutomationProperties.AutomationId="provider_only_configured"
                      Checked="Filter_Changed"
                      Unchecked="Filter_Changed" />
            <TextBlock x:Name="CountText"
                       VerticalAlignment="Center"
                       Style="{StaticResource MutedTextStyle}" />
        </StackPanel>

        <ListView Grid.Row="4"
                  x:Name="ProviderList"
                  AutomationProperties.AutomationId="provider_list"
                  SelectionMode="None"
                  ScrollViewer.VerticalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,3" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ProviderRow">
                    <Border Padding="14,12"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                    <Ellipse Width="10"
                                             Height="10"
                                             VerticalAlignment="Center"
                                             AutomationProperties.AccessibilityView="Raw"
                                             Fill="{x:Bind StatusBrushKey, Converter={StaticResource ThemeBrushConverter}}" />
                                    <TextBlock Text="{x:Bind DisplayName}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Border Padding="6,1"
                                            CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind ActiveLabel}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Badges}"
                                               FontSize="11"
                                               Opacity="0.6"
                                               VerticalAlignment="Center"
                                               Visibility="{x:Bind HasBadges, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{x:Bind SelectLabel}"
                                        AutomationProperties.Name="{x:Bind SelectAutomationName}"
                                        AutomationProperties.AutomationId="{x:Bind SelectAutomationId}"
                                        Tag="{x:Bind Id}"
                                        Click="SelectProviderFromList_Click"
                                        Padding="10,4"
                                        FontSize="11"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="{x:Bind MetaLine}"
                                       FontSize="12"
                                       Opacity="0.6" />

                            <ItemsControl ItemsSource="{x:Bind Keys}"
                                          Visibility="{x:Bind HasKeys, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:EnvKeyRow">
                                        <Grid ColumnSpacing="10" Padding="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0"
                                                     Width="8"
                                                     Height="8"
                                                     VerticalAlignment="Center"
                                                     Fill="{x:Bind StatusBrushKey, Converter={StaticResource ThemeBrushConverter}}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind VariableName}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind StatusLabel}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{x:Bind SourceLabel}"
                                                       FontSize="12"
                                                       Opacity="0.6"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
    </ScrollViewer>
</Page>
