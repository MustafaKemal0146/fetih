<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fetih.Desktop.Views.Settings.PermissionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Fetih.Desktop.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,16,24,32" Spacing="16" MaxWidth="980" HorizontalAlignment="Left">

            <TextBlock Text="İzinler" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Style="{StaticResource MutedTextStyle}"
                       Text="Hangi araç çağrısının onay isteyeceğini belirleyen onay (approval) politikası. Bir siber güvenlik aracında bu isteğe bağlı değil, çekirdek özelliktir: varsayılan olarak yıkıcı ve ağa çıkan komutlar onay ister." />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Onay politikası" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ItemsControl x:Name="ApprovalRows" ItemTemplate="{StaticResource SettingRowTemplate}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Kalıcı komut izin listesi" Style="{StaticResource SectionHeaderTextStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Text="config.yaml içindeki command_allowlist listesi. Kullanıcı bir onay isteminde &quot;her zaman izin ver&quot; dediğinde tehlikeli komut deseninin anahtarı buraya yazılır ve bir daha sorulmaz." />
                    <TextBlock x:Name="AllowlistEmptyText"
                               Style="{StaticResource MutedTextStyle}"
                               Visibility="Collapsed" />
                    <ItemsControl x:Name="AllowlistItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,6"
                                        Margin="0,2"
                                        CornerRadius="4"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <TextBlock Text="{Binding}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Onay isteyen komut sınıfları" Style="{StaticResource SectionHeaderTextStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Text="Python tarafındaki tehlikeli komut dedektörünün (tools/approval.py) kapsadığı sınıflar. Bu liste referanstır: bir komut bu sınıflardan birine girdiğinde onay istenir, izin listesinde değilse çalıştırılmaz." />
                    <ItemsControl x:Name="RiskRows" ItemTemplate="{StaticResource SettingRowTemplate}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Güvenlik taraması" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ItemsControl x:Name="SecurityRows" ItemTemplate="{StaticResource SettingRowTemplate}" />
                </StackPanel>
            </Border>

            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="Informational"
                     Title="Salt okunur"
                     Message="Faz 1'de bu sayfa yalnızca gösterim yapar. Onay akışının satır içi kartları (izin ver / reddet / her zaman izin ver) Faz 2'de sohbet akışına eklenecek." />

            <Button x:Name="RefreshButton"
                    Content="Yeniden oku"
                    AutomationProperties.AutomationId="permissions_refresh"
                    Click="RefreshButton_Click" />
        </StackPanel>
    </ScrollViewer>
</Page>
