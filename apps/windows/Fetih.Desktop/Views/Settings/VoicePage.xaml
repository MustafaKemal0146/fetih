<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fetih.Desktop.Views.Settings.VoicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer AutomationProperties.AutomationId="voice_scroll"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Enabled">
        <StackPanel Padding="24,16,24,32" Spacing="16" MaxWidth="920" HorizontalAlignment="Left">

            <TextBlock Text="Ses" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Style="{StaticResource MutedTextStyle}"
                       Text="FETİH'in ses yetenekleri: metin okuma (TTS), konuşma tanıma (STT) ve bas-konuş kaydı. Değerler ~/.fetih/config.yaml dosyasından okunur." />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Metin okuma (TTS)" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ItemsControl x:Name="TtsRows" ItemTemplate="{StaticResource SettingRowTemplate}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Konuşma tanıma (STT)" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ItemsControl x:Name="SttRows" ItemTemplate="{StaticResource SettingRowTemplate}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Kayıt davranışı" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ItemsControl x:Name="RecordingRows" ItemTemplate="{StaticResource SettingRowTemplate}" />
                </StackPanel>
            </Border>

            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="Informational"
                     Title="Faz 3"
                     Message="Bas-konuş girişi ve yanıt okuma masaüstü kabuğuna Faz 3'te bağlanacak. Bu sayfa şimdilik Python tarafındaki gerçek ses yapılandırmasını salt okunur gösterir." />

            <Button x:Name="RefreshButton"
                    Content="Yeniden oku"
                    AutomationProperties.AutomationId="voice_refresh"
                    Click="RefreshButton_Click" />
        </StackPanel>
    </ScrollViewer>
</Page>
