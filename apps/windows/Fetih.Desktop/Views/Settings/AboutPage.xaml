<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fetih.Desktop.Views.Settings.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer AutomationProperties.AutomationId="about_scroll"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Enabled">
        <StackPanel Padding="24,16,24,32" Spacing="16" MaxWidth="880" HorizontalAlignment="Left">

            <TextBlock Text="Hakkında" Style="{StaticResource PageTitleTextStyle}" />

            <!-- Marka -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="64"
                            Height="64"
                            CornerRadius="12"
                            VerticalAlignment="Top"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <TextBlock Text="F"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="ProductText" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="TaglineText" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   Text="CTF çözümü, sızma testi, OSINT, adli bilişim ve kırmızı takım operasyonları için model-agnostik bir ajan. Masaüstü uygulaması kabuktur; ajan mantığı Python tarafında çalışır." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Uygulama bilgisi -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Uygulama bilgisi" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ItemsControl x:Name="AppRows" ItemTemplate="{StaticResource SettingRowTemplate}" />
                </StackPanel>
            </Border>

            <!-- Bağlantılar -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Bağlantılar" Style="{StaticResource SectionHeaderTextStyle}" />
                    <HyperlinkButton x:Name="RepoLink"
                                     Content="Proje deposu — github.com/MustafaKemal0146/fetih"
                                     AutomationProperties.AutomationId="about_repo" />
                    <HyperlinkButton x:Name="ReleasesLink"
                                     Content="Sürümler ve yayın notları"
                                     AutomationProperties.AutomationId="about_releases" />
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Margin="12,4,0,0"
                               Text="Masaüstü uygulaması tasarım belgesi: docs/windows-app-plani.md (depo içinde)" />
                </StackPanel>
            </Border>

            <!-- Yasal / kapsam uyarısı -->
            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="Warning"
                     Title="Kapsam uyarısı"
                     Message="FETİH bir saldırı simülasyonu ve güvenlik testi aracıdır. Yalnızca sahibi olduğun ya da yazılı izin aldığın sistemlerde kullan." />
        </StackPanel>
    </ScrollViewer>
</Page>
