<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fetih.Desktop.Views.Settings.ConfigEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        SORUN 1: sayfanın kökü her zaman bir ScrollViewer'dır; pencere küçük
        olsa bile en alttaki satıra kaydırarak erişilebilir.
    -->
    <ScrollViewer Padding="24,20,24,32"
                  AutomationProperties.AutomationId="config_scroll"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Enabled">
        <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">

            <TextBlock x:Name="TitleText"
                       Style="{StaticResource PageTitleTextStyle}"
                       Text="Ayarlar" />

            <TextBlock x:Name="SubtitleText"
                       Style="{StaticResource MutedTextStyle}"
                       MaxWidth="820"
                       HorizontalAlignment="Left" />

            <!--
                Detaylı Mod uyarısı: bu sayfa ham yapılandırmadır ve normal
                Ayarlar sayfalarıyla karıştırılmamalıdır. Kapatılamaz.
            -->
            <InfoBar x:Name="AdvancedWarning"
                     AutomationProperties.AutomationId="config_advanced_warning"
                     IsOpen="False"
                     IsClosable="False"
                     Severity="Warning"
                     MaxWidth="900"
                     HorizontalAlignment="Left" />

            <!-- Durum / uyarı şeridi -->
            <InfoBar x:Name="StatusBar"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Informational" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ReloadButton"
                        AutomationProperties.AutomationId="config_reload"
                        Click="ReloadButton_Click" />
                <ProgressRing x:Name="BusyRing"
                              Width="18" Height="18"
                              IsActive="False"
                              VerticalAlignment="Center" />
            </StackPanel>

            <!-- Alanlar burada kod arkasında oluşturulur -->
            <StackPanel x:Name="FieldsHost"
                        AutomationProperties.AutomationId="config_fields"
                        Spacing="6" />

            <TextBlock x:Name="EmptyText"
                       Style="{StaticResource MutedTextStyle}"
                       Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
