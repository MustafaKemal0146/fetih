<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Fetih.Desktop.Views.ActivityPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Fetih.Desktop.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Sağ panel (issue #53): o an çalışan alt-ajanları (delegate_task) ve
        arka plan süreçlerini (terminal background) canlı gösterir. Veriler
        köprünün tool_call/tool_result olaylarından türetilir; agent çekirdeğine
        dokunulmaz. Yalnızca aktif oturum gösterilir.
    -->
    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderThickness="1,0,0,0"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="14,12,10,10" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="1">
                <TextBlock x:Name="HeaderText"
                           FontWeight="SemiBold"
                           FontSize="14" />
                <TextBlock x:Name="SubHeaderText"
                           FontSize="11"
                           Opacity="0.6" />
            </StackPanel>
            <Button Grid.Column="1"
                    x:Name="StopAllButton"
                    Padding="8,4"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="activity_stop_all"
                    Click="StopAllButton_Click" />
        </Grid>

        <TextBlock Grid.Row="1"
                   x:Name="EmptyText"
                   Margin="16,24,16,0"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Opacity="0.55"
                   FontSize="12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ActivityItems" Padding="10,0,10,14">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ActivityItem">
                        <Border Margin="0,4,0,0"
                                Padding="12,10"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0"
                                              Glyph="{x:Bind Glyph}"
                                              FontSize="16"
                                              VerticalAlignment="Center"
                                              Opacity="0.8" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                                                   FontSize="11"
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap"
                                                   MaxLines="3" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                Spacing="3"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                                            <Ellipse Width="8" Height="8"
                                                     VerticalAlignment="Center"
                                                     AutomationProperties.AccessibilityView="Raw"
                                                     Fill="{x:Bind StatusBrushKey, Mode=OneWay, Converter={StaticResource ThemeBrushConverter}}" />
                                            <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Elapsed, Mode=OneWay}"
                                                   FontSize="11"
                                                   Opacity="0.6"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{x:Bind Detail, Mode=OneWay}"
                                           FontSize="11"
                                           FontFamily="Consolas"
                                           Opacity="0.7"
                                           TextWrapping="Wrap"
                                           MaxLines="4"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind HasDetail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
