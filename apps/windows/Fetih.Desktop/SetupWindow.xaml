<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fetih.Desktop.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Başlık çubuğu -->
        <Border x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="16,0">
            <TextBlock Text="FETİH · İlk Kurulum"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />
        </Border>

        <Grid Grid.Row="1" Padding="32,12,32,28">
            <!-- 1) Karşılama / güvenlik uyarısı -->
            <StackPanel x:Name="WelcomePanel" Spacing="16" MaxWidth="620" HorizontalAlignment="Left">
                <TextBlock Text="FETİH'e hoş geldin" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Style="{StaticResource MutedTextStyle}"
                           Text="FETİH bir CTF / sızma testi / OSINT yapay zekâ ajanıdır. Bu sihirbaz bir model sağlayıcısı seçmene, API anahtarını güvenle kaydetmene ve Masaüstü Köprüsü'nü başlatmana yardımcı olur." />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Güvenlik notu" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   Text="API anahtarın yalnızca bu bilgisayardaki ~/.fetih/.env dosyasına yazılır. Değeri hiçbir zaman ekranda gösterilmez, günlüğe yazılmaz veya ağ üzerinden gönderilmez." />
                    </StackPanel>
                </Border>
                <Button Content="Devam"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.AutomationId="setup_welcome_continue"
                        Click="WelcomeContinue_Click" />
            </StackPanel>

            <!-- 2) Sağlayıcı + anahtar -->
            <StackPanel x:Name="ProviderPanel" Spacing="14" Visibility="Collapsed"
                        MaxWidth="620" HorizontalAlignment="Left">
                <TextBlock Text="Model sağlayıcısı" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Style="{StaticResource MutedTextStyle}"
                           Text="FETİH model-agnostiktir; aşağıdan bir sağlayıcı seç. Ücretsiz başlamak için Groq iyi bir seçenektir." />

                <ComboBox x:Name="ProviderCombo"
                          Header="Sağlayıcı"
                          Width="360"
                          HorizontalAlignment="Left"
                          AutomationProperties.AutomationId="setup_provider_combo"
                          SelectionChanged="ProviderCombo_SelectionChanged" />

                <PasswordBox x:Name="KeyBox"
                             Header="API anahtarı"
                             Width="360"
                             HorizontalAlignment="Left"
                             AutomationProperties.AutomationId="setup_api_key"
                             PlaceholderText="sk-… / gsk_…" />

                <TextBox x:Name="ModelBox"
                         Header="Varsayılan model (isteğe bağlı)"
                         Width="360"
                         HorizontalAlignment="Left"
                         AutomationProperties.AutomationId="setup_model"
                         PlaceholderText="ör. openai/gpt-oss-120b" />

                <TextBlock x:Name="KeyHint" Style="{StaticResource MutedTextStyle}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Geri" Click="ProviderBack_Click" />
                    <Button Content="Kur ve başlat"
                            Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.AutomationId="setup_install"
                            Click="ProviderInstall_Click" />
                </StackPanel>
            </StackPanel>

            <!-- 3) Kurulum ilerlemesi -->
            <StackPanel x:Name="ProgressPanel" Spacing="14" Visibility="Collapsed"
                        MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Text="Kuruluyor" Style="{StaticResource PageTitleTextStyle}" />
                <ProgressBar x:Name="OverallProgress" Minimum="0" Maximum="1" Value="0" Width="640" HorizontalAlignment="Left" />
                <ItemsControl x:Name="StepList"
                              AutomationProperties.AutomationId="setup_steps">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="10" Padding="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="14" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Text="{Binding Message}" Opacity="0.7" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="False" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RetryButton" Content="Yeniden dene" Visibility="Collapsed" Click="Retry_Click" />
                    <Button x:Name="BackToProviderButton" Content="Sağlayıcıya dön" Visibility="Collapsed" Click="ProviderBack_Click" />
                    <Button x:Name="GoToChatButton" Content="Sohbete geç"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="Collapsed"
                            AutomationProperties.AutomationId="setup_finish"
                            Click="GoToChat_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
